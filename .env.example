# Required - absolute URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://meenakshiartwork.example.com
# Required for Vercel auto-detection (usually set automatically on Vercel)
# NEXT_PUBLIC_VERCEL_URL=meenakshiartwork.vercel.app

# Required - build-time SQLite seed (DB is build/ISR only, not request-time)
DATABASE_URL=file:./prisma/dev.db

# Optional - Google Analytics 4 (enables the GA loader wired in app/layout.tsx)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional - Sentry (error tracking + source maps on production builds)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
