# ============================================================
# Meenakshi Art Work — Environment Configuration
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# ---- CDN Configuration (Phase 5) ----
# Set to "vercel-blob", "cloudinary", or "none" (default)
NEXT_PUBLIC_CDN_PROVIDER=none

# CDN base URL (e.g. https://your-store.public.blob.vercel-storage.com for Vercel Blob)
NEXT_PUBLIC_CDN_BASE_URL=

# URL path prefix for images on the CDN (default: /images)
NEXT_PUBLIC_CDN_PREFIX=/images

# ---- Vercel Blob (required if NEXT_PUBLIC_CDN_PROVIDER=vercel-blob) ----
# Get this from Vercel → Storage → Blob → Settings
BLOB_READ_WRITE_TOKEN=

# ---- Cloudinary (required if NEXT_PUBLIC_CDN_PROVIDER=cloudinary) ----
# Get these from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Sentry (optional) ----
# Get these from Sentry → Projects → Your Project → Settings → Keys
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ---- Google Analytics 4 (optional) ----
# Get this from analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Google Maps (optional) ----
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ---- Build scripts: I/O concurrency (optional) ----
# Max images uploaded/compressed at once by the CDN/optimize scripts (default: 8)
CDN_UPLOAD_CONCURRENCY=8

# ---- Certificate route: caching & rate limiting ----
# Max generated certificate images kept in the in-memory LRU cache (default: 50)
CERT_CACHE_MAX=50
# Requests per minute allowed per visitor on the certificate download route (default: 30)
CERT_RATE_LIMIT_PER_MIN=30

# ============================================================
# Usage Notes
# ============================================================
# 1. For local development without CDN, leave NEXT_PUBLIC_CDN_PROVIDER=none
#    Images are served from /public/images as before.
#
# 2. To migrate to CDN:
#    a. Set NEXT_PUBLIC_CDN_PROVIDER and NEXT_PUBLIC_CDN_BASE_URL
#    b. Run `npm run cdn:upload` (Vercel Blob) or `npm run cdn:upload:cloudinary`
#    c. All /images/ paths are automatically resolved to the CDN URL
#    d. next.config.mjs automatically adds the CDN hostname to images.remotePatterns
#
# 3. The script generates cdn-mapping.json mapping local → CDN URLs for reference.
# ============================================================